# ============================================
# RMV Stainless Steel Fabrication - Backend
# .env example (no real secrets)
# ============================================

# Server
# production uses NODE_ENV=production
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# MongoDB
# production format includes the rmv_system database and Atlas appName
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/rmv_system?retryWrites=true&w=majority&appName=Cluster0

# JWT
# Must be strong random strings (16+ chars minimum)
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies
# current production metadata
COOKIE_DOMAIN=rmvfabrication.app
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# CORS
CORS_ORIGIN=https://rmvfabrication.app

# Email provider: smtp | sendgrid_api | resend_api
EMAIL_PROVIDER=resend_api

# SMTP metadata from current production
# SMTP fields remain populated even when EMAIL_PROVIDER=resend_api
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-smtp-or-api-password
SMTP_FROM_EMAIL=noreply@rmvfabrication.app
SMTP_FROM_NAME=RMV Stainless Steel

# API keys (use only one provider based on EMAIL_PROVIDER)
SENDGRID_API_KEY=
RESEND_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=rmv-server
R2_PUBLIC_URL=https://your-r2-public-url.example

# OpenRouteService
ORS_API_KEY=your-ors-api-key

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@rmvsteelfab.com
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# CSRF
# Must be overridden in production
CSRF_SECRET=change-me-csrf-secret-32chars-min

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (used in email links and redirects)
FRONTEND_URL=https://rmvfabrication.app

# Feature flags: direct ocular booking flow
# These keys exist in the schema but are not currently present in the live production env.
FEATURE_DIRECT_OCULAR_STAFF_ENABLED=false
FEATURE_DIRECT_OCULAR_CUSTOMER_ENABLED=false
FEATURE_DIRECT_OCULAR_STAFF_PILOT_IDS=
FEATURE_DIRECT_OCULAR_CUSTOMER_PILOT_IDS=

# Firebase Admin service account JSON encoded as base64
FIREBASE_SERVICE_ACCOUNT_B64=
