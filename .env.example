# ============================================
# RMV Stainless Steel Fabrication - Backend
# .env example (no real secrets)
# ============================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/rmv_system?retryWrites=true&w=majority

# JWT
# Must be strong random strings (16+ chars minimum)
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookies
# production example:
# COOKIE_DOMAIN=rmvfabrication.app
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGIN=http://localhost:5173

# Email provider: smtp | sendgrid_api | resend_api
EMAIL_PROVIDER=smtp

# SMTP (for EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=RMV Stainless Steel

# API keys (use only one provider based on EMAIL_PROVIDER)
SENDGRID_API_KEY=
RESEND_API_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=rmv-uploads
R2_PUBLIC_URL=https://your-r2-public-url.example

# OpenRouteService
ORS_API_KEY=your-ors-api-key

# Super Admin Seed
SUPER_ADMIN_EMAIL=admin@rmvsteelfab.com
SUPER_ADMIN_PASSWORD=change-me-super-admin-password
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# CSRF
# Must be overridden in production
CSRF_SECRET=change-me-csrf-secret-32chars-min

# PayMongo
PAYMONGO_SECRET_KEY=sk_test_your_key_here
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (used in email links and redirects)
FRONTEND_URL=http://localhost:5173

# Feature flags: direct ocular booking flow
FEATURE_DIRECT_OCULAR_STAFF_ENABLED=false
FEATURE_DIRECT_OCULAR_CUSTOMER_ENABLED=false
FEATURE_DIRECT_OCULAR_STAFF_PILOT_IDS=
FEATURE_DIRECT_OCULAR_CUSTOMER_PILOT_IDS=

# Firebase Admin service account JSON encoded as base64
FIREBASE_SERVICE_ACCOUNT_B64=
